[Unit]
Description=Aether OAS broker socket
Before=aether-oas.service
PartOf=aether-oas.service
ConditionPathExists=/var/lib/aether/activation/activation-record.json
ConditionPathExists=/var/lib/aether/activation/unit-generations/g-45393132b1a0ab8a0415c7d964f800b983155bbd4ebe13bb2764bf94548ea652.ready

[Socket]
ListenSequentialPacket=/run/aether/oas/broker.sock
FileDescriptorName=broker
SocketUser=aether-oas
SocketGroup=root
SocketMode=0660
Backlog=64
Accept=no
DirectoryMode=0755
RemoveOnStop=yes
Service=aether-oas.service
